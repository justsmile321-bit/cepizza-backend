PORT=3000
# Public https address of this server (no trailing slash)
PUBLIC_URL=https://your-server.example.com
# Password for the staff orders screen (username: staff)
STAFF_PASSWORD=change-me
# URL scheme the iOS app listens on
APP_SCHEME=cepizza
DB_PATH=./data/orders.db

# Stripe — cards (dashboard.stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal — developer.paypal.com → Apps & Credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Pricing — keep in sync with ShopConfig.swift
TAX_RATE=0.0735
CARD_FEE=0.50
DELIVERY_FEE=0
DELIVERY_MINIMUM=15

# Delivery area
DELIVERY_RADIUS_MILES=5
SHOP_ADDRESS=1111 Burnside Ave, East Hartford, CT 06108
